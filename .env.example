LEXWARE_BASE_URL=https://api.lexware.io
LEXWARE_CLIENT_ID=
LEXWARE_CLIENT_SECRET=
LEXWARE_ACCESS_TOKEN=
LEXWARE_REFRESH_TOKEN=
LEXWARE_TOKEN_URL=https://api.lexware.io/oauth/token
LEXWARE_COMPANY_ID=
LEXWARE_DRAFT_ENDPOINT=/v1/quotations
LEXWARE_TEMPLATES_ENDPOINT=/v1/text-modules
LEXWARE_CUSTOMERS_ENDPOINT=/v1/contacts
LEXWARE_DEFAULT_NET_AMOUNT=1.0
LEXWARE_DEFAULT_TAX_RATE=19.0
LEXWARE_PAYMENT_TERM_DAYS=14

# Mandantenspezifische Lexware-Accounts (optional)
# Namensschema: LEXWARE_<KEY>__<MANDANT_ID_IN_GROSSBUCHSTABEN>
# Beispiel-Mandant-ID: ges_energietechnik -> GES_ENERGIETECHNIK

# G.E.S. Energietechnik GmbH
LEXWARE_BASE_URL__GES_ENERGIETECHNIK=
LEXWARE_CLIENT_ID__GES_ENERGIETECHNIK=
LEXWARE_CLIENT_SECRET__GES_ENERGIETECHNIK=
LEXWARE_ACCESS_TOKEN__GES_ENERGIETECHNIK=
LEXWARE_REFRESH_TOKEN__GES_ENERGIETECHNIK=
LEXWARE_TOKEN_URL__GES_ENERGIETECHNIK=
LEXWARE_COMPANY_ID__GES_ENERGIETECHNIK=
LEXWARE_DRAFT_ENDPOINT__GES_ENERGIETECHNIK=
LEXWARE_TEMPLATES_ENDPOINT__GES_ENERGIETECHNIK=
LEXWARE_CUSTOMERS_ENDPOINT__GES_ENERGIETECHNIK=

# G.E.S. Power Service GmbH
LEXWARE_BASE_URL__GES_POWER_SERVICE=
LEXWARE_CLIENT_ID__GES_POWER_SERVICE=
